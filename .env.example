# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# --- Postgres ---
# NOTE: POSTGRES_PASSWORD is only applied by the postgres image on first-ever
# init of an empty data volume. If you change DB_PASSWORD after the volume
# already exists, the running Postgres instance keeps the OLD password even
# though DATABASE_URL below now has the new one — auth will fail until you
# either update the password inside Postgres to match, or wipe the volume.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=bos_butter

# Full connection string used by the backend/auth-backend services.
# Must stay in sync with DB_PASSWORD above (URL-encode special characters, e.g. @ -> %40).
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/bos_butter

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS ---
# Origin(s) allowed to call the auth-backend / chatbot APIs from the browser.
# Set to the real frontend URL when deploying (e.g. https://your-vm-domain.com).
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Ollama / chatbot ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
RAG_TOP_K=3
RAG_MIN_SCORE=0.20

# Chat completions go to OpenRouter when this is set; unset (local dev
# default) keeps using local Ollama (OLLAMA_CHAT_MODEL above).
OPENROUTER_API_KEY=
# Typhoon2 70B: Thai-English instruction-tuned, chosen for Thai output
# quality. 8K context window — keep RAG_TOP_K/history modest.
OPENROUTER_CHAT_MODEL=scb10x/llama3.1-typhoon2-70b-instruct

# --- Frontend ---
FASTAPI_BASE_URL=http://localhost:8000
